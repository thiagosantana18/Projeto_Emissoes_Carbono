# Copie para .env (NUNCA versione o .env). Hoje nada abaixo é obrigatório.

# --- Opcional: sobrescrever caminhos (útil em deploy/testes) ---
# ESG_PROJECT_ROOT=
# ESG_DATA_DIR=

# --- LLM local (Hugging Face) — valores abaixo são os PADRÕES; só defina o que quiser mudar ---
# ESG_LLM_MODEL=lxyuan/distilbert-base-multilingual-cased-sentiments-student
# ESG_LLM_REVISION=           # commit do Hub (fixe para reprodutibilidade)
# ESG_MODEL_DIR=              # padrão: <raiz>/Models/hf_cache
# ESG_LLM_OFFLINE=1           # 1: a API nunca baixa o modelo (baixe antes com Code/llm/baixar_modelo.py)
# ESG_LLM_DEVICE=cpu          # cpu | cuda | auto
# ESG_LLM_THREADS=            # limite de threads da CPU (ex.: 2) em máquina modesta
# ESG_LLM_MAX_CHARS=2000      # caracteres por texto
# ESG_LLM_MAX_TOKENS=256      # truncamento do tokenizador
# ESG_LLM_MAX_LOTE=32         # textos por requisição em lote
# ESG_LLM_TIMEOUT=30          # segundos por inferência (excedeu: HTTP 504)
# ESG_LLM_MAX_PENDENTES=4     # requisições simultâneas (excedeu: HTTP 429)
# ESG_LLM_COOLDOWN=30         # espera após falha de carga (segundos)
# ESG_LLM_PRELOAD=0           # 1: carrega o modelo ao subir a API

# --- IA online (sumarização, perguntas, insights) — defina UMA das chaves; nunca versione este arquivo ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ESG_IA_PROVIDER=openai          # openai | anthropic (padrão: o primeiro com chave)
# ESG_OPENAI_MODEL=gpt-5-mini     # confirme o nome atual na página de modelos da OpenAI
# ESG_ANTHROPIC_MODEL=claude-haiku-5-5
# ESG_OPENAI_BASE_URL=            # servidor compatível com a API da OpenAI (ex.: http://localhost:11434/v1 para Ollama); chave opcional
# ESG_IA_MAX_TOKENS=3000          # modelos de raciocínio gastam tokens antes de responder: não use valores baixos
# ESG_IA_TEMPERATURA=             # vazio = padrão do modelo (alguns modelos recusam valores customizados)
# ESG_IA_TIMEOUT=90               # segundos por chamada ao provedor
# ESG_IA_RETENTATIVAS=2           # retentativas em 429/5xx/timeout
# ESG_IA_MAX_CHARS=60000          # caracteres máximos por texto enviado para resumo
# ESG_IA_MAX_CHAMADAS_HORA=60     # teto local de chamadas/hora (controle de custo)
# ESG_IA_MAX_DOCS=40              # documentos por resumo do corpus
# ESG_IA_CACHE=1                  # 1: reaproveita respostas idênticas (sem nova cobrança)

# --- Etapa futura: consulta real de fatores de emissão ---
# CLIMATIQ_API_KEY=
